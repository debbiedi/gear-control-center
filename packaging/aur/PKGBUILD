# Maintainer: Kadir Nergiz <lahgamingtr@gmail.com>
pkgname=headset-control-center
pkgver=0.2.0
pkgrel=1
pkgdesc="Desktop control panel for USB gaming headsets — shows only what the hardware actually reports"
arch=('x86_64')
url="https://github.com/debbiedi/headset-control-center"
license=('MIT')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'alsa-lib'
  'systemd-libs'
  'hicolor-icon-theme'
)
makedepends=('rust' 'cargo' 'nodejs' 'npm' 'pkgconf')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('5981912e8885da7c30b9c6e793136eedada75c68dc491a74a969cc36d6c98bde')

prepare() {
  cd "$pkgname-$pkgver"
  npm ci
  cd src-tauri
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # No CARGO_TARGET_DIR here: the Tauri CLI changes into src-tauri before
  # invoking cargo, so a relative value doubles the path and the binary lands
  # somewhere package() cannot find it.
  #
  # --no-bundle: the AppImage and deb bundlers are for the project's own
  # releases. Here pacman is the package manager, so only the binary is wanted.
  npm run tauri build -- --no-bundle
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 "src-tauri/target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "packaging/$pkgname.desktop" \
    "$pkgdir/usr/share/applications/$pkgname.desktop"

  for size in 32 128; do
    install -Dm644 "src-tauri/icons/${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/$pkgname.png"
  done

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  for doc in docs/hardware.md docs/protocol.md docs/troubleshooting.md; do
    install -Dm644 "$doc" "$pkgdir/usr/share/doc/$pkgname/$(basename "$doc")"
  done
}
