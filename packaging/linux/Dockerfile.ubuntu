# Ubuntu 22.04, and the release matters more than anything else in this file.
#
# A binary demands the glibc it was linked against, so whichever distribution
# builds it sets the floor for every machine that can run it. Built on Arch the
# executable asks for GLIBC_2.39 and will not start on Ubuntu 22.04 (2.35) or
# Debian 12 (2.36). Built here it asks for 2.35 and starts on both, and on
# everything newer.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl file pkg-config xz-utils \
      libwebkit2gtk-4.1-dev libgtk-3-dev librsvg2-dev \
      libayatana-appindicator3-dev libasound2-dev libudev-dev libssl-dev \
      patchelf desktop-file-utils \
    && rm -rf /var/lib/apt/lists/*

ARG NODE_VERSION=22.14.0
RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
      | tar -xJ -C /usr/local --strip-components=1

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH=/root/.cargo/bin:$PATH

# linuxdeploy ships a strip that cannot read .relr.dyn sections, and it wants
# to mount its own AppImage, which a container will not allow.
ENV NO_STRIP=true APPIMAGE_EXTRACT_AND_RUN=1

WORKDIR /src
