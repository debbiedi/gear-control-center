{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Gear Control Center",
  "version": "0.5.0",
  "identifier": "dev.gearcc.control",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run build:cli"
  },
  "app": {
    "windows": [
      {
        "title": "Gear Control Center",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "category": "Utility",
    "shortDescription": "Control and configure your gaming headset and mouse",
    "longDescription": "Detects supported USB gaming headsets and mice, holds them open together, and exposes only the controls the connected hardware genuinely supports.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/gearctl": "target/release/gearctl"
        }
      },
      "rpm": {
        "files": {
          "/usr/bin/gearctl": "target/release/gearctl"
        }
      }
    }
  }
}
